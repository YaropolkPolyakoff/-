<UserControl x:Class="DanceApp.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DanceApp.Converters"
             Background="{StaticResource BackgroundDarkBrush}">

    <UserControl.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Card item template -->
        <DataTemplate x:Key="DanceCardTemplate">
            <Border x:Name="CardBorder"
                    Width="240" Height="300"
                    CornerRadius="14"
                    Margin="12"
                    ClipToBounds="True"
                    Cursor="Hand"
                    MouseLeftButtonDown="CardBorder_MouseLeftButtonDown">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" CenterX="120" CenterY="150"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BackgroundCardBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1.04" Duration="0:0:0.15"/>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1.04" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1.0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <!-- Cover image (raster .png) -->
                    <Image Source="{Binding ImagePath}"
                           Stretch="UniformToFill"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch"/>

                    <!-- Gradient overlay -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.3" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#EE000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Accent top bar using style's accent color -->
                    <Rectangle Height="4"
                               VerticalAlignment="Top"
                               Fill="{Binding AccentColor, Converter={StaticResource HexToBrush}}"/>

                    <!-- Text info -->
                    <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,18">
                        <TextBlock Text="{Binding Name}"
                                   Style="{StaticResource CardTitleStyle}"
                                   FontSize="20"/>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"/>
                        <!-- Lesson badge -->
                        <Border Background="{Binding AccentColor, Converter={StaticResource HexToBrush}}"
                                CornerRadius="20"
                                HorizontalAlignment="Left"
                                Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <!-- Book icon (vector) -->
                                <Path Fill="White" Margin="0,0,5,0"
                                      Data="M1,0 L9,0 C10,0 11,1 11,2 L11,14 C11,15 10,16 9,16 L1,16 C0,16 -1,15 -1,14 L-1,2 C-1,1 0,0 1,0 Z M2,4 L8,4 M2,7 L8,7 M2,10 L6,10"
                                      Stroke="White" StrokeThickness="1.2" Width="11" Height="16"
                                      Stretch="Fill"/>
                                <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                    <Run Text="{Binding LessonCount}"/>
                                    <Run Text=" уроков"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Hover "open" arrow (vector, appears on hover) -->
                    <Border x:Name="HoverArrow"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="12"
                            Opacity="0">
                        <Path Fill="White"
                              Data="M0,6 L8,0 L16,6 L10,6 L10,14 L6,14 L6,6 Z"
                              Width="16" Height="14" Stretch="Fill"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="90"/>
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Decorative background gradient blob -->
        <Ellipse Width="600" Height="400"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-100,-200,0"
                 Opacity="0.04">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FF6C3DE3" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,0">
            <StackPanel>
                <!-- Header -->
                <StackPanel Margin="16,24,0,20">
                    <TextBlock Text="Каталог стилей"
                               Style="{StaticResource HeadingStyle}"/>
                    <TextBlock Text="Выберите направление и начните обучение"
                               Style="{StaticResource SubHeadingStyle}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Cards grid (wrapping) -->
                <ItemsControl x:Name="StylesItemsControl"
                              ItemTemplate="{StaticResource DanceCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Left" Margin="4,0,0,24"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
