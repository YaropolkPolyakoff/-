<UserControl x:Class="DanceApp.Views.VideoPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DanceApp.Converters"
             Background="{StaticResource BackgroundDarkBrush}">

   <UserControl.Resources>
       <conv:TimeSpanToStringConverter  x:Key="TsToStr"/>
       <conv:ActiveStepToBrushConverter x:Key="ActiveStepBrush"/>
       <conv:BoolToVisibilityConverter  x:Key="BoolToVis"/>

        <!-- Step list item template -->
        <DataTemplate x:Key="StepTemplate">
            <Border x:Name="StepBorder"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="0,4"
                    Cursor="Hand"
                    Background="{Binding IsActive, Converter={StaticResource ActiveStepBrush}}"
                    MouseLeftButtonDown="StepItem_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step number badge (vector circle) -->
                    <Grid Grid.Column="0">
                        <Ellipse Width="26" Height="26">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF6C3DE3" Offset="0"/>
                                    <GradientStop Color="#FF3A86FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding Number}"
                                   Foreground="White"
                                   FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Step info -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                        <!-- Time range -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Path Fill="#FF6C3DE3"
                                  Data="M8,0 A8,8 0 1 1 7.99,0 Z M8,4 L8,8 L11,11"
                                  Stroke="#FF6C3DE3" StrokeThickness="1.5"
                                  Width="12" Height="12" Stretch="Fill" Margin="0,0,4,0"/>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10">
                                <Run Text="{Binding StartTime, StringFormat={}{0:0}s}"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding EndTime, StringFormat={}{0:0}s}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,16,16,16">
        <Grid.ColumnDefinitions>
            <!-- Player column -->
            <ColumnDefinition Width="2*" MinWidth="400"/>
            <ColumnDefinition Width="12"/>
            <!-- Steps column -->
            <ColumnDefinition Width="*" MinWidth="260"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ LEFT: VIDEO PLAYER ═══════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- title / lesson selector -->
                <RowDefinition Height="*"/>     <!-- video area -->
                <RowDefinition Height="Auto"/>  <!-- progress bar -->
                <RowDefinition Height="Auto"/>  <!-- controls bar -->
            </Grid.RowDefinitions>

            <!-- Heading row -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="StyleNameTb"
                               Text="Учебный модуль"
                               Style="{StaticResource HeadingStyle}"
                               FontSize="22"/>
                    <TextBlock x:Name="LessonTitleTb"
                               Text="Выберите стиль в каталоге"
                               Style="{StaticResource SubHeadingStyle}"/>
                </StackPanel>
                <!-- Lesson selector combo -->
                <ComboBox x:Name="LessonCombo"
                          Grid.Column="1"
                          Width="180"
                          VerticalAlignment="Center"
                          Background="{StaticResource BackgroundCardBrush}"
                          Foreground="White"
                          BorderBrush="{StaticResource DividerBrush}"
                          SelectionChanged="LessonCombo_SelectionChanged"/>
            </Grid>

            <!-- Video area -->
            <Border Grid.Row="1"
                    CornerRadius="12"
                    Background="Black"
                    ClipToBounds="True"
                    MinHeight="260">

                <!-- ScaleTransform used for mirror effect -->
                <Grid x:Name="VideoContainer">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="MirrorTransform" ScaleX="1" CenterX="400"/>
                    </Grid.RenderTransform>

                    <MediaElement x:Name="VideoPlayer"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  Stretch="Uniform"
                                  MediaOpened="VideoPlayer_MediaOpened"
                                  MediaEnded="VideoPlayer_MediaEnded"
                                  MediaFailed="VideoPlayer_MediaFailed"/>

                    <!-- Placeholder when no video loaded -->
                    <StackPanel x:Name="PlaceholderPanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <!-- Large play icon (vector) -->
                        <Canvas Width="80" Height="80" HorizontalAlignment="Center">
                            <Ellipse Width="80" Height="80" Fill="#22FFFFFF"/>
                            <Polygon Points="30,20 65,40 30,60"
                                     Fill="White" Opacity="0.6"/>
                        </Canvas>
                        <TextBlock Text="Выберите урок для просмотра"
                                   Foreground="#66FFFFFF"
                                   FontSize="14"
                                   Margin="0,16,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progress / seek bar -->
            <Grid Grid.Row="2" Margin="0,10,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionLabel"
                           Grid.Column="0"
                           Text="00:00"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <Slider x:Name="SeekSlider"
                        Grid.Column="1"
                        Style="{StaticResource PlayerSliderStyle}"
                        Minimum="0" Maximum="100" Value="0"
                        IsMoveToPointEnabled="True"
                        ValueChanged="SeekSlider_ValueChanged"
                        PreviewMouseDown="SeekSlider_PreviewMouseDown"
                        PreviewMouseUp="SeekSlider_PreviewMouseUp"/>
                <TextBlock x:Name="DurationLabel"
                           Grid.Column="2"
                           Text="00:00"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>

            <!-- Loop A-B markers row -->
            <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="44,0,44,0">
                <Canvas x:Name="LoopMarkerCanvas" Height="8" ClipToBounds="False">
                    <!-- A marker (vector) -->
                    <Path x:Name="MarkerA"
                          Data="M0,0 L0,-12 L6,-6 Z"
                          Fill="{StaticResource AccentBrush}"
                          Canvas.Left="0"
                          Visibility="Collapsed"/>
                    <!-- B marker (vector) -->
                    <Path x:Name="MarkerB"
                          Data="M0,0 L0,-12 L-6,-6 Z"
                          Fill="#FF3A86FF"
                          Canvas.Left="0"
                          Visibility="Collapsed"/>
                </Canvas>
            </Grid>

            <!-- Controls bar -->
            <Border Grid.Row="3"
                    Background="{StaticResource BackgroundCardBrush}"
                    CornerRadius="12"
                    Padding="16,10"
                    Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Speed buttons -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Скорость:"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <RadioButton x:Name="Speed05Btn"
                                     Content="0.5×"
                                     Style="{StaticResource ToggleButtonStyle}"
                                     GroupName="Speed"
                                     Checked="SpeedButton_Checked" Tag="0.5"
                                     Margin="0,0,6,0"/>
                        <RadioButton x:Name="Speed075Btn"
                                     Content="0.75×"
                                     Style="{StaticResource ToggleButtonStyle}"
                                     GroupName="Speed"
                                     Checked="SpeedButton_Checked" Tag="0.75"
                                     Margin="0,0,6,0"/>
                        <RadioButton x:Name="Speed1Btn"
                                     Content="1×"
                                     Style="{StaticResource ToggleButtonStyle}"
                                     GroupName="Speed"
                                     IsChecked="True"
                                     Checked="SpeedButton_Checked" Tag="1.0"/>
                    </StackPanel>

                    <!-- Center: Playback controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Skip back 10s (vector) -->
                        <Button Style="{StaticResource PlayerIconButtonStyle}"
                                Click="SkipBack_Click"
                                ToolTip="-10 сек"
                                Margin="0,0,8,0">
                            <Canvas Width="20" Height="20">
                                <Path Stroke="White" StrokeThickness="2"
                                      Data="M15,2 A8,8 0 1 0 15,18"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Polygon Points="15,2 10,2 10,7" Fill="White"/>
                                <TextBlock Canvas.Left="6" Canvas.Top="7"
                                           Text="10" Foreground="White" FontSize="6" FontWeight="Bold"/>
                            </Canvas>
                        </Button>

                        <!-- Play / Pause (vector) -->
                        <Button x:Name="PlayPauseBtn"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                Width="52" Height="52"
                                Click="PlayPause_Click"
                                Margin="0,0,8,0">
                            <Canvas Width="22" Height="22" x:Name="PlayPauseIcon">
                                <!-- Play icon -->
                                <Polygon x:Name="PlayIcon"
                                         Points="4,2 20,11 4,20"
                                         Fill="White"/>
                                <!-- Pause icon (hidden by default) -->
                                <StackPanel x:Name="PauseIcon"
                                            Orientation="Horizontal"
                                            Visibility="Collapsed">
                                    <Rectangle Width="5" Height="18" Fill="White" RadiusX="2" RadiusY="2"
                                               Canvas.Left="3" Canvas.Top="2"/>
                                    <Rectangle Width="5" Height="18" Fill="White" RadiusX="2" RadiusY="2"
                                               Canvas.Left="14" Canvas.Top="2"/>
                                </StackPanel>
                            </Canvas>
                        </Button>

                        <!-- Skip forward 10s (vector) -->
                        <Button Style="{StaticResource PlayerIconButtonStyle}"
                                Click="SkipForward_Click"
                                ToolTip="+10 сек">
                            <Canvas Width="20" Height="20">
                                <Path Stroke="White" StrokeThickness="2"
                                      Data="M5,2 A8,8 0 1 1 5,18"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Polygon Points="5,2 10,2 10,7" Fill="White"/>
                                <TextBlock Canvas.Left="6" Canvas.Top="7"
                                           Text="10" Foreground="White" FontSize="6" FontWeight="Bold"/>
                            </Canvas>
                        </Button>
                    </StackPanel>

                    <!-- Right: Mirror + Loop toggle buttons -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- Mirror toggle -->
                        <ToggleButton x:Name="MirrorToggle"
                                      Style="{StaticResource ToggleButtonStyle}"
                                      Checked="MirrorToggle_Checked"
                                      Unchecked="MirrorToggle_Unchecked"
                                      ToolTip="Зеркальное отражение"
                                      Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      Data="M0,8 L6,0 L6,4 L10,4 L10,12 L6,12 L6,16 Z M14,8 L20,0 L20,4 L16,4 L16,12 L20,12 L20,16 Z"
                                      Width="20" Height="16" Stretch="Fill" Margin="0,0,6,0"/>
                                <TextBlock Text="Зеркало"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                           FontSize="12"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Loop A-B toggle -->
                        <ToggleButton x:Name="LoopToggle"
                                      Style="{StaticResource ToggleButtonStyle}"
                                      Checked="LoopToggle_Checked"
                                      Unchecked="LoopToggle_Unchecked"
                                      ToolTip="Зацикливание отрезка A–B (кликните в плеере для установки A, затем B)">
                            <StackPanel Orientation="Horizontal">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.5"
                                      Data="M2,8 C2,4 6,2 10,2 C14,2 18,4 18,8 C18,12 14,14 10,14 C8,14 6,13 5,12 L5,16 L1,12 L5,8"
                                      Width="20" Height="16" Stretch="Fill" Margin="0,0,6,0"
                                      StrokeLineJoin="Round"/>
                                <TextBlock Text="A–B Loop"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                           FontSize="12"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ RIGHT: STEPS LIST ═══════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Шаги связки"
                           Style="{StaticResource HeadingStyle}"
                           FontSize="18"/>
                <TextBlock Text="Нажмите на шаг для перехода"
                           Style="{StaticResource SubHeadingStyle}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{StaticResource BackgroundCardBrush}"
                    CornerRadius="12"
                    Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="StepsListControl"
                                  ItemTemplate="{StaticResource StepTemplate}"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
