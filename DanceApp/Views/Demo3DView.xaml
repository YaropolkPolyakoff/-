<UserControl x:Class="DanceApp.Views.Demo3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}">

    <UserControl.Resources>
        <!-- 3D rotation storyboard (auto-spin) -->
        <Storyboard x:Key="AutoRotateStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="DancerRotation"
                Storyboard.TargetProperty="Angle"
                From="0" To="360"
                Duration="0:0:8"/>
        </Storyboard>

        <!-- Step pose animation (Y tilt) -->
        <Storyboard x:Key="PoseStepStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="DancerTiltRotation"
                Storyboard.TargetProperty="Angle"
                From="0" To="15"
                Duration="0:0:0.4"
                AutoReverse="True"
                EasingFunction="{x:Null}"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- 3D + controls -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="3D Демонстрация"
                       Style="{StaticResource HeadingStyle}"/>
            <TextBlock Text="Вращайте камеру мышью · прокрутка — зум · кнопки — движения"
                       Style="{StaticResource SubHeadingStyle}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════ 3D Viewport ═══════ -->
            <Border Grid.Column="0"
                    CornerRadius="14"
                    Background="{StaticResource BackgroundCardBrush}"
                    ClipToBounds="True"
                    Margin="0,0,12,0">

                <Grid>
                    <Viewport3D x:Name="Viewport"
                                MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                                MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                                MouseMove="Viewport_MouseMove"
                                MouseWheel="Viewport_MouseWheel">

                        <!-- Camera -->
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="Camera"
                                               Position="0,2,6"
                                               LookDirection="0,-0.3,-1"
                                               UpDirection="0,1,0"
                                               FieldOfView="60"/>
                        </Viewport3D.Camera>

                        <!-- Lighting -->
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup>
                                    <AmbientLight Color="#FF404060"/>
                                    <DirectionalLight Color="#FFDDD0FF" Direction="-1,-1,-0.5"/>
                                    <DirectionalLight Color="#FF302050" Direction="1,0.5,0.5"/>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                        <!-- ── DANCER MODEL (geometric figure) ── -->
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup>
                                    <!-- Apply combined transforms -->
                                    <Model3DGroup.Transform>
                                        <Transform3DGroup>
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="DancerRotation"
                                                                         Axis="0,1,0" Angle="0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="DancerTiltRotation"
                                                                         Axis="0,0,1" Angle="0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                        </Transform3DGroup>
                                    </Model3DGroup.Transform>

                                    <!-- HEAD (sphere approximated as icosahedron-like geom) -->
                                    <GeometryModel3D>
                                        <GeometryModel3D.Material>
                                            <DiffuseMaterial>
                                                <DiffuseMaterial.Brush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FF9B72FF" Offset="0"/>
                                                        <GradientStop Color="#FF6C3DE3" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </DiffuseMaterial.Brush>
                                            </DiffuseMaterial>
                                        </GeometryModel3D.Material>
                                        <GeometryModel3D.Geometry>
                                            <MeshGeometry3D
                                                Positions="0,2.6,0  -0.3,2.2,-0.3  0.3,2.2,-0.3  0.3,2.2,0.3  -0.3,2.2,0.3  0,1.9,0"
                                                TriangleIndices="0,1,2  0,2,3  0,3,4  0,4,1  5,2,1  5,3,2  5,4,3  5,1,4"/>
                                        </GeometryModel3D.Geometry>
                                    </GeometryModel3D>

                                    <!-- TORSO -->
                                    <GeometryModel3D>
                                        <GeometryModel3D.Material>
                                            <DiffuseMaterial>
                                                <DiffuseMaterial.Brush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FF6C3DE3" Offset="0"/>
                                                        <GradientStop Color="#FF3A86FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </DiffuseMaterial.Brush>
                                            </DiffuseMaterial>
                                        </GeometryModel3D.Material>
                                        <GeometryModel3D.Geometry>
                                            <MeshGeometry3D
                                                Positions="-0.4,1.9,-0.2  0.4,1.9,-0.2  0.4,1.9,0.2  -0.4,1.9,0.2
                                                           -0.35,0.8,-0.2  0.35,0.8,-0.2  0.35,0.8,0.2  -0.35,0.8,0.2"
                                                TriangleIndices="0,1,2  0,2,3  4,6,5  4,7,6
                                                                 0,5,1  0,4,5  1,6,2  1,5,6
                                                                 2,7,3  2,6,7  3,4,0  3,7,4"/>
                                        </GeometryModel3D.Geometry>
                                    </GeometryModel3D>

                                    <!-- LEFT LEG -->
                                    <GeometryModel3D>
                                        <GeometryModel3D.Material>
                                            <DiffuseMaterial>
                                                <DiffuseMaterial.Brush>
                                                    <SolidColorBrush Color="#FF4A1FA8"/>
                                                </DiffuseMaterial.Brush>
                                            </DiffuseMaterial>
                                        </GeometryModel3D.Material>
                                        <GeometryModel3D.Geometry>
                                            <MeshGeometry3D
                                                Positions="-0.35,0.8,-0.15  -0.05,0.8,-0.15  -0.05,0.8,0.15  -0.35,0.8,0.15
                                                           -0.35,-0.8,-0.15  -0.05,-0.8,-0.15  -0.05,-0.8,0.15  -0.35,-0.8,0.15"
                                                TriangleIndices="0,1,2  0,2,3  4,6,5  4,7,6
                                                                 0,5,1  0,4,5  1,6,2  1,5,6
                                                                 2,7,3  2,6,7  3,4,0  3,7,4"/>
                                        </GeometryModel3D.Geometry>
                                    </GeometryModel3D>

                                    <!-- RIGHT LEG -->
                                    <GeometryModel3D>
                                        <GeometryModel3D.Material>
                                            <DiffuseMaterial>
                                                <DiffuseMaterial.Brush>
                                                    <SolidColorBrush Color="#FF4A1FA8"/>
                                                </DiffuseMaterial.Brush>
                                            </DiffuseMaterial>
                                        </GeometryModel3D.Material>
                                        <GeometryModel3D.Geometry>
                                            <MeshGeometry3D
                                                Positions="0.05,0.8,-0.15  0.35,0.8,-0.15  0.35,0.8,0.15  0.05,0.8,0.15
                                                           0.05,-0.8,-0.15  0.35,-0.8,-0.15  0.35,-0.8,0.15  0.05,-0.8,0.15"
                                                TriangleIndices="0,1,2  0,2,3  4,6,5  4,7,6
                                                                 0,5,1  0,4,5  1,6,2  1,5,6
                                                                 2,7,3  2,6,7  3,4,0  3,7,4"/>
                                        </GeometryModel3D.Geometry>
                                    </GeometryModel3D>

                                    <!-- LEFT ARM -->
                                    <GeometryModel3D>
                                        <GeometryModel3D.Material>
                                            <DiffuseMaterial Brush="#FF9B72FF"/>
                                        </GeometryModel3D.Material>
                                        <GeometryModel3D.Geometry>
                                            <MeshGeometry3D
                                                Positions="-0.4,1.85,-0.1  -0.6,1.85,-0.1  -0.6,1.85,0.1  -0.4,1.85,0.1
                                                           -0.4,0.9,-0.1   -0.6,0.9,-0.1   -0.6,0.9,0.1   -0.4,0.9,0.1"
                                                TriangleIndices="0,1,2  0,2,3  4,6,5  4,7,6
                                                                 0,5,1  0,4,5  1,6,2  1,5,6
                                                                 2,7,3  2,6,7  3,4,0  3,7,4"/>
                                        </GeometryModel3D.Geometry>
                                    </GeometryModel3D>

                                    <!-- RIGHT ARM -->
                                    <GeometryModel3D>
                                        <GeometryModel3D.Material>
                                            <DiffuseMaterial Brush="#FF9B72FF"/>
                                        </GeometryModel3D.Material>
                                        <GeometryModel3D.Geometry>
                                            <MeshGeometry3D
                                                Positions="0.4,1.85,-0.1   0.6,1.85,-0.1   0.6,1.85,0.1   0.4,1.85,0.1
                                                           0.4,0.9,-0.1    0.6,0.9,-0.1    0.6,0.9,0.1    0.4,0.9,0.1"
                                                TriangleIndices="0,1,2  0,2,3  4,6,5  4,7,6
                                                                 0,5,1  0,4,5  1,6,2  1,5,6
                                                                 2,7,3  2,6,7  3,4,0  3,7,4"/>
                                        </GeometryModel3D.Geometry>
                                    </GeometryModel3D>

                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>

                        <!-- Floor grid -->
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <GeometryModel3D>
                                    <GeometryModel3D.Material>
                                        <DiffuseMaterial Brush="#22FFFFFF"/>
                                    </GeometryModel3D.Material>
                                    <GeometryModel3D.Geometry>
                                        <MeshGeometry3D
                                            Positions="-2,-0.8,-2  2,-0.8,-2  2,-0.8,2  -2,-0.8,2"
                                            TriangleIndices="0,1,2  0,2,3"/>
                                    </GeometryModel3D.Geometry>
                                </GeometryModel3D>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>

                    <!-- Overlay instructions -->
                    <TextBlock Text="ЛКМ: вращение  •  Колесо: зум"
                               Foreground="#44FFFFFF"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,12"/>
                </Grid>
            </Border>

            <!-- ═══════ Right: controls ═══════ -->
            <StackPanel Grid.Column="1" Spacing="12">

                <!-- Auto-rotate toggle -->
                <ToggleButton x:Name="AutoRotateToggle"
                              Content="▶  Авто-вращение"
                              Style="{StaticResource ToggleButtonStyle}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Padding="0,12"
                              Checked="AutoRotateToggle_Checked"
                              Unchecked="AutoRotateToggle_Unchecked"/>

                <!-- Reset camera -->
                <Button Content="⟳  Сбросить камеру"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Padding="0,12"
                        Click="ResetCamera_Click"/>

                <!-- Movement steps list -->
                <Border Background="{StaticResource BackgroundCardBrush}"
                        CornerRadius="12"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Движения"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Margin="0,0,0,10"/>

                        <!-- Step buttons generated in code -->
                        <ItemsControl x:Name="PoseButtonsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Style="{StaticResource BaseButtonStyle}"
                                            Foreground="White"
                                            Background="#22FFFFFF"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,10"
                                            Margin="0,3"
                                            Click="PoseButton_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Camera info -->
                <Border Background="{StaticResource BackgroundCardBrush}"
                        CornerRadius="12"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Управление камерой"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,0,0,8"/>
                        <!-- Vector info icons with text -->
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Path Data="M4,0 L8,0 L8,16 L4,16 Z M0,4 L4,4 L4,0 L8,0 L8,16 L4,16 L4,12 L0,12 Z"
                                  Fill="{StaticResource AccentBrush}" Width="12" Height="16" Stretch="Fill" Margin="0,0,8,0"/>
                            <TextBlock Text="ЛКМ — орбитальное вращение"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Path Data="M4,2 L8,8 L4,14 M0,2 L4,8 L0,14"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                  Width="12" Height="16" Stretch="Fill" Margin="0,0,8,0"/>
                            <TextBlock Text="Колесо мыши — приближение"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
